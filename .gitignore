# ============================================================================
# RAGLens AI - ignore rules for the whole repository (backend + frontend)
# ============================================================================

# ---------------------------------------------------------------------------
# Secrets and local environment files
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Python (backend/)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, coverage and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Runtime data produced by the app (recreated automatically)
# ---------------------------------------------------------------------------
# SQLite databases (raglens.db, mlflow.db) and their WAL files
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# MLflow local tracking / artifacts
mlruns/
mlartifacts/

# Logs
*.log
logs/

# ---------------------------------------------------------------------------
# Node.js / Next.js (frontend/)
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Frontend test coverage / deploy tooling
coverage/
.vercel/
.turbo/

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker-compose.override.yml

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
