# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# SQLite (default, zero setup) or PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://raglens:raglens@localhost:5432/raglens
DATABASE_URL=sqlite+aiosqlite:///./raglens.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM --------------------------------------------------------------------
# "local" = offline extractive generator (no key needed); "anthropic" = Claude
LLM_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_JUDGE_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# Model whose pricing is used to project costs for free local runs
COST_REFERENCE_MODEL=claude-opus-5-5

# --- Retrieval --------------------------------------------------------------
VECTOR_STORE=memory
# QDRANT_URL=http://localhost:6333

# --- Experiment tracking ----------------------------------------------------
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=raglens-ai

# --- Observability ----------------------------------------------------------
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- Evaluation runtime -----------------------------------------------------
EVALUATION_CONCURRENCY=4
# Run the A/B/C/D example experiments on first start (empty database only)
AUTO_SEED_EXPERIMENTS=true
